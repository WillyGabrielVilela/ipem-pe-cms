# URL pública da aplicação (usada pelo CMS em CORS/CSRF)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# PostgreSQL gerenciado (Neon, Supabase ou PostgreSQL próprio)
DATABASE_URL=postgresql://usuario:senha@host:5432/ipem_pe?sslmode=require

# Gere um segredo aleatório forte. Não compartilhe nem versione o .env.
PAYLOAD_SECRET=COLOQUE_UM_SEGREDO_ALEATORIO_FORTE_AQUI

# Token de Vercel Blob para persistência das imagens em produção
BLOB_READ_WRITE_TOKEN=
